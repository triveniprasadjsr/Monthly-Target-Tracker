rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateId(dateId) {
      return dateId is string && dateId.size() == 10 && dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Entity Blueprints
    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'phoneNumber', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'phoneNumber', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == uid && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.phoneNumber is string && data.phoneNumber.size() <= 30
        && data.photoURL is string && data.photoURL.size() <= 25000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDashboardState(data, uid, docId) {
      return data.keys().hasAll([
          'docId', 'uid', 'mainName', 'surname', 'email', 'phone', 'photo',
          'tasks', 'activeTask', 'currentYear', 'currentMonth', 'selectedDay',
          'records', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'docId', 'uid', 'mainName', 'surname', 'email', 'phone', 'photo',
          'tasks', 'activeTask', 'currentYear', 'currentMonth', 'selectedDay',
          'records', 'createdAt', 'updatedAt'
        ])
        && data.docId is string && data.docId.size() >= 1 && data.docId.size() <= 128 && data.docId == docId
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == uid && data.uid == request.auth.uid
        && data.mainName is string && data.mainName.size() >= 1 && data.mainName.size() <= 100
        && data.surname is string && data.surname.size() >= 1 && data.surname.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.phone is string && data.phone.size() <= 40
        && data.photo is string && data.photo.size() <= 50000
        && data.tasks is list && data.tasks.size() >= 1 && data.tasks.size() <= 50
        && data.tasks[0] is string && data.tasks[0].size() >= 1 && data.tasks[0].size() <= 100
        && data.activeTask is string && data.activeTask.size() >= 1 && data.activeTask.size() <= 100
        && data.currentYear is number && data.currentYear >= 1970 && data.currentYear <= 2100
        && data.currentMonth is number && data.currentMonth >= 0 && data.currentMonth <= 11
        && data.selectedDay is number && data.selectedDay >= 1 && data.selectedDay <= 31
        && data.records is map && data.records.size() <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTracker(data, uid, trackerId) {
      return data.keys().hasAll([
          'trackerId', 'uid', 'name', 'type', 'description', 'trackingMethod',
          'monthlyGoal', 'dailyTargetHours', 'defaultSubject', 'defaultTask',
          'archived', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'trackerId', 'uid', 'name', 'type', 'description', 'trackingMethod',
          'monthlyGoal', 'dailyTargetHours', 'defaultSubject', 'defaultTask',
          'archived', 'createdAt', 'updatedAt'
        ])
        && data.trackerId is string && data.trackerId.size() >= 1 && data.trackerId.size() <= 128 && data.trackerId == trackerId
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == uid && data.uid == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.type is string && data.type.size() <= 30 && data.type in ['study', 'habit', 'goal', 'fitness', 'expense', 'custom']
        && data.description is string && data.description.size() <= 500
        && data.trackingMethod is string && data.trackingMethod.size() <= 30 && data.trackingMethod in ['status', 'study_hours', 'expense_log']
        && data.monthlyGoal is number && data.monthlyGoal >= 0 && data.monthlyGoal <= 100000000
        && data.dailyTargetHours is number && data.dailyTargetHours >= 0 && data.dailyTargetHours <= 24
        && data.defaultSubject is string && data.defaultSubject.size() <= 100
        && data.defaultTask is string && data.defaultTask.size() <= 300
        && data.archived is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyRecord(data, uid, trackerId, dateId) {
      return data.keys().hasAll([
          'date', 'uid', 'trackerId', 'status', 'subject',
          'taskDescription', 'studyDurationMinutes', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'date', 'uid', 'trackerId', 'status', 'subject',
          'taskDescription', 'studyDurationMinutes', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.date is string && data.date.size() == 10 && data.date == dateId && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == uid && data.uid == request.auth.uid
        && data.trackerId is string && data.trackerId.size() >= 1 && data.trackerId.size() <= 128 && data.trackerId == trackerId
        && data.status is string && data.status.size() <= 20 && data.status in ['completed', 'not_completed', 'skipped', 'not_marked']
        && data.subject is string && data.subject.size() <= 100
        && data.taskDescription is string && data.taskDescription.size() <= 500
        && data.studyDurationMinutes is number && data.studyDurationMinutes >= 0 && data.studyDurationMinutes <= 1440
        && data.notes is string && data.notes.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpenseRecord(data, uid, expenseId) {
      return data.keys().hasAll([
          'expenseId', 'uid', 'trackerId', 'date', 'monthKey', 'title',
          'amount', 'category', 'paymentMethod', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'expenseId', 'uid', 'trackerId', 'date', 'monthKey', 'title',
          'amount', 'category', 'paymentMethod', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.expenseId is string && data.expenseId.size() >= 1 && data.expenseId.size() <= 128 && data.expenseId == expenseId
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == uid && data.uid == request.auth.uid
        && data.trackerId is string && data.trackerId.size() >= 1 && data.trackerId.size() <= 128 && data.trackerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.amount is number && data.amount > 0 && data.amount <= 100000000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.paymentMethod is string && data.paymentMethod.size() <= 50
        && data.notes is string && data.notes.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserSettings(data, uid, settingId) {
      return data.keys().hasAll([
          'settingId', 'uid', 'theme', 'currency', 'weekStartsOn',
          'defaultTrackerId', 'timezone', 'excludedWeekdays', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'settingId', 'uid', 'theme', 'currency', 'weekStartsOn',
          'defaultTrackerId', 'timezone', 'excludedWeekdays', 'createdAt', 'updatedAt'
        ])
        && data.settingId is string && data.settingId.size() >= 1 && data.settingId.size() <= 128 && data.settingId == settingId
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == uid && data.uid == request.auth.uid
        && data.theme is string && data.theme.size() <= 20 && data.theme in ['light', 'dark', 'system']
        && data.currency is string && data.currency.size() <= 10 && data.currency in ['INR', 'USD', 'EUR', 'GBP']
        && data.weekStartsOn is number && (data.weekStartsOn == 0 || data.weekStartsOn == 1)
        && data.defaultTrackerId is string && data.defaultTrackerId.size() <= 128
        && data.timezone is string && data.timezone.size() >= 1 && data.timezone.size() <= 80
        && data.excludedWeekdays is list && data.excludedWeekdays.size() <= 6
        && (data.excludedWeekdays.size() == 0 || (data.excludedWeekdays[0] is number && data.excludedWeekdays[0] >= 0 && data.excludedWeekdays[0] <= 6))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 1. User Profiles
    match /users/{uid} {
      allow get: if isOwner(uid) && isValidId(uid);
      allow list: if false;
      allow create: if isOwner(uid)
        && isValidId(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(uid)
        && isValidId(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update Profile Info
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'photoURL', 'email', 'updatedAt'])
        );
      allow delete: if isOwner(uid) && isValidId(uid);

      // 1B. Dashboard State Subcollection
      match /dashboard/{docId} {
        allow get: if isOwner(uid)
          && isValidId(uid)
          && isValidId(docId)
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow list: if isOwner(uid) && existing().uid == request.auth.uid;
        allow create: if isOwner(uid)
          && isValidId(uid)
          && isValidId(docId)
          && isValidDashboardState(incoming(), uid, docId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow update: if isOwner(uid)
          && isValidId(uid)
          && isValidId(docId)
          && isValidDashboardState(incoming(), uid, docId)
          && incoming().docId == existing().docId
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action: Sync Dashboard State
            incoming().diff(existing()).affectedKeys().hasOnly([
              'mainName', 'surname', 'email', 'phone', 'photo',
              'tasks', 'activeTask', 'currentYear', 'currentMonth', 'selectedDay',
              'records', 'updatedAt'
            ])
          )
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow delete: if isOwner(uid)
          && isValidId(uid)
          && isValidId(docId)
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
      }

      // 2. Trackers Subcollection
      match /trackers/{trackerId} {
        allow get: if isOwner(uid)
          && isValidId(uid)
          && isValidId(trackerId)
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow list: if isOwner(uid) && existing().uid == request.auth.uid;
        allow create: if isOwner(uid)
          && isValidId(uid)
          && isValidId(trackerId)
          && isValidTracker(incoming(), uid, trackerId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow update: if isOwner(uid)
          && isValidId(uid)
          && isValidId(trackerId)
          && isValidTracker(incoming(), uid, trackerId)
          && incoming().trackerId == existing().trackerId
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action: Edit Tracker Details or Archive Status
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'type', 'description', 'trackingMethod', 'monthlyGoal',
              'dailyTargetHours', 'defaultSubject', 'defaultTask', 'archived', 'updatedAt'
            ])
          )
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow delete: if isOwner(uid)
          && isValidId(uid)
          && isValidId(trackerId)
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;

        // 3. Daily Records Subcollection
        match /dailyRecords/{dateId} {
          allow get: if isOwner(uid)
            && isValidId(uid)
            && isValidId(trackerId)
            && isValidDateId(dateId)
            && get(/databases/$(database)/documents/users/$(uid)/trackers/$(trackerId)).data.uid == request.auth.uid;
          allow list: if isOwner(uid) && existing().uid == request.auth.uid;
          allow create: if isOwner(uid)
            && isValidId(uid)
            && isValidId(trackerId)
            && isValidDateId(dateId)
            && isValidDailyRecord(incoming(), uid, trackerId, dateId)
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && get(/databases/$(database)/documents/users/$(uid)/trackers/$(trackerId)).data.uid == request.auth.uid;
          allow update: if isOwner(uid)
            && isValidId(uid)
            && isValidId(trackerId)
            && isValidDateId(dateId)
            && isValidDailyRecord(incoming(), uid, trackerId, dateId)
            && incoming().date == existing().date
            && incoming().uid == existing().uid
            && incoming().trackerId == existing().trackerId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              // Action: Update Daily Status or Study Activity
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'subject', 'taskDescription', 'studyDurationMinutes', 'notes', 'updatedAt'
              ])
            )
            && get(/databases/$(database)/documents/users/$(uid)/trackers/$(trackerId)).data.uid == request.auth.uid;
          allow delete: if isOwner(uid)
            && isValidId(uid)
            && isValidId(trackerId)
            && isValidDateId(dateId)
            && get(/databases/$(database)/documents/users/$(uid)/trackers/$(trackerId)).data.uid == request.auth.uid;
        }
      }

      // 4. Expenses Subcollection
      match /expenses/{expenseId} {
        allow get: if isOwner(uid)
          && isValidId(uid)
          && isValidId(expenseId)
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow list: if isOwner(uid) && existing().uid == request.auth.uid;
        allow create: if isOwner(uid)
          && isValidId(uid)
          && isValidId(expenseId)
          && isValidExpenseRecord(incoming(), uid, expenseId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/users/$(uid)/trackers/$(incoming().trackerId)).data.uid == request.auth.uid;
        allow update: if isOwner(uid)
          && isValidId(uid)
          && isValidId(expenseId)
          && isValidExpenseRecord(incoming(), uid, expenseId)
          && incoming().expenseId == existing().expenseId
          && incoming().uid == existing().uid
          && incoming().trackerId == existing().trackerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action: Update Expense Entry
            incoming().diff(existing()).affectedKeys().hasOnly([
              'date', 'monthKey', 'title', 'amount', 'category', 'paymentMethod', 'notes', 'updatedAt'
            ])
          )
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow delete: if isOwner(uid)
          && isValidId(uid)
          && isValidId(expenseId)
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
      }

      // 5. User Settings Subcollection
      match /settings/{settingId} {
        allow get: if isOwner(uid)
          && isValidId(uid)
          && isValidId(settingId)
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow list: if isOwner(uid) && existing().uid == request.auth.uid;
        allow create: if isOwner(uid)
          && isValidId(uid)
          && isValidId(settingId)
          && isValidUserSettings(incoming(), uid, settingId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow update: if isOwner(uid)
          && isValidId(uid)
          && isValidId(settingId)
          && isValidUserSettings(incoming(), uid, settingId)
          && incoming().settingId == existing().settingId
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action: Update Preferences
            incoming().diff(existing()).affectedKeys().hasOnly([
              'theme', 'currency', 'weekStartsOn', 'defaultTrackerId', 'timezone', 'excludedWeekdays', 'updatedAt'
            ])
          )
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow delete: if isOwner(uid)
          && isValidId(uid)
          && isValidId(settingId)
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
      }
    }
  }
}
