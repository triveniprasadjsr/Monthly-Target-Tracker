<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monthly Target & Task Tracker</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Merriweather:wght@700;900&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Merriweather', 'Georgia', 'serif'],
                    },
                    colors: {
                        navy: {
                            950: '#070b14',
                            900: '#0b101e',
                            800: '#10172a',
                            700: '#17213a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #090d18;
            color: #f8fafc;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        /* Exact Cyan Banner Gradient */
        .cyan-banner {
            background: linear-gradient(90deg, #0284c7 0%, #00a8e8 50%, #0284c7 100%);
            box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.35);
        }

        /* Double Cyan Separator Line above Yellow Header */
        .cyan-double-line {
            height: 5px;
            background: linear-gradient(90deg, #00b4d8, #0096c7, #00b4d8);
            border-top: 1px solid #48cae4;
            border-bottom: 1px solid #023e8a;
        }

        /* Bright Yellow Calendar Header */
        .yellow-day-header {
            background-color: #e6e600;
            color: #050505;
            font-family: 'Merriweather', Georgia, serif;
            letter-spacing: 0.04em;
        }

        /* Calendar Grid Cell */
        .calendar-cell {
            min-height: 92px;
            background-color: #0c1222;
            border: 1px solid #151f38;
            transition: all 0.18s ease;
            position: relative;
            user-select: none;
        }

        .calendar-cell.active-day:hover {
            background-color: #121c34;
            border-color: #253861;
        }

        /* Selected / Current Day Cell Highlight */
        .calendar-cell.selected-day {
            border: 2px solid #0ea5e9 !important;
            background: radial-gradient(circle at center, rgba(14, 165, 233, 0.14) 0%, rgba(12, 18, 34, 0.96) 100%);
            box-shadow: inset 0 0 18px rgba(14, 165, 233, 0.22), 0 0 10px rgba(14, 165, 233, 0.18);
            z-index: 10;
        }

        /* Subtle Cell Tint for 3 Statuses */
        .calendar-cell.status-completed {
            background: radial-gradient(circle at center, rgba(16, 185, 129, 0.15) 0%, rgba(12, 18, 34, 0.96) 100%);
            border-color: rgba(16, 185, 129, 0.38);
        }
        .calendar-cell.status-not_completed {
            background: radial-gradient(circle at center, rgba(239, 68, 68, 0.15) 0%, rgba(12, 18, 34, 0.96) 100%);
            border-color: rgba(239, 68, 68, 0.38);
        }
        .calendar-cell.status-skipped {
            background: radial-gradient(circle at center, rgba(234, 179, 8, 0.15) 0%, rgba(12, 18, 34, 0.96) 100%);
            border-color: rgba(234, 179, 8, 0.38);
        }

        /* Circular Date Button Inside Calendar Cell */
        .date-circle {
            width: 44px;
            height: 44px;
            border-radius: 9999px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.92rem;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }
        @media (min-width: 640px) {
            .date-circle {
                width: 48px;
                height: 48px;
                font-size: 1rem;
            }
        }
        .calendar-cell.active-day:hover .date-circle {
            transform: scale(1.08);
        }

        /* Unmarked Circular Date */
        .date-circle-unmarked {
            background-color: #131d36;
            border: 2px solid #28375c;
            color: #cbd5e1;
        }
        .calendar-cell.selected-day .date-circle-unmarked {
            border-color: #38bdf8;
            color: #38bdf8;
            box-shadow: 0 0 12px rgba(56, 189, 248, 0.35);
        }

        /* GREEN = Completed Circular Date */
        .date-circle-completed {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            border: 2px solid #6ee7b7;
            color: #ffffff;
            box-shadow: 0 0 16px rgba(16, 185, 129, 0.5);
        }

        /* RED = Not Completed Circular Date */
        .date-circle-not_completed {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            border: 2px solid #fca5a5;
            color: #ffffff;
            box-shadow: 0 0 16px rgba(239, 68, 68, 0.5);
        }

        /* YELLOW = Skipped Circular Date */
        .date-circle-skipped {
            background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
            border: 2px solid #fde047;
            color: #090d16;
            box-shadow: 0 0 16px rgba(234, 179, 8, 0.45);
        }

        /* Stat Boxes */
        .stat-completed {
            background: linear-gradient(180deg, rgba(6, 78, 59, 0.5) 0%, rgba(6, 78, 59, 0.2) 100%);
            border: 1px solid rgba(16, 185, 129, 0.4);
        }
        .stat-not-completed {
            background: linear-gradient(180deg, rgba(127, 29, 29, 0.5) 0%, rgba(127, 29, 29, 0.2) 100%);
            border: 1px solid rgba(239, 68, 68, 0.4);
        }
        .stat-skipped {
            background: linear-gradient(180deg, rgba(113, 63, 18, 0.5) 0%, rgba(113, 63, 18, 0.2) 100%);
            border: 1px solid rgba(234, 179, 8, 0.4);
        }
        .stat-rate {
            background: linear-gradient(180deg, rgba(12, 74, 110, 0.5) 0%, rgba(12, 74, 110, 0.22) 100%);
            border: 1px solid rgba(56, 189, 248, 0.4);
        }
        .btn-graph {
            background: linear-gradient(180deg, rgba(49, 46, 129, 0.55) 0%, rgba(30, 27, 75, 0.45) 100%);
            border: 1px solid rgba(99, 102, 241, 0.5);
        }
        .btn-graph:hover {
            background: linear-gradient(180deg, rgba(67, 56, 202, 0.7) 0%, rgba(49, 46, 129, 0.65) 100%);
            border-color: rgba(129, 140, 248, 0.85);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #090d18;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #0ea5e9;
        }

        /* Print Styles */
        @media print {
            body {
                background-color: #090d18 !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .no-print {
                display: none !important;
            }
            .print-full {
                width: 100% !important;
                max-width: 100% !important;
            }
            .calendar-cell {
                min-height: 75px !important;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-sky-500 selection:text-white">

    <!-- TOP HEADER BAR -->
    <header class="w-full bg-[#0c1220] border-b border-slate-800/80 px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <!-- Sidebar Toggle -->
            <button onclick="toggleSidebar()" title="Toggle Personal Profile Sidebar" class="no-print w-9 h-9 rounded-lg bg-[#151f36] hover:bg-[#1e2c4c] border border-slate-700/70 flex items-center justify-center text-sky-400 transition">
                <i class="fa-solid fa-id-card text-sm"></i>
            </button>
            <div>
                <h1 id="headerTitle" class="font-serif text-lg sm:text-2xl md:text-[25px] font-black tracking-wide text-white leading-tight">
                    XXX YYY’s Target Tracker
                </h1>
            </div>
        </div>

        <!-- Top Right Action Buttons -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 no-print">
            <!-- Quick Click Legend Pill (Desktop) -->
            <div class="hidden 2xl:flex items-center gap-3 bg-[#121a2d] border border-slate-800 px-3.5 py-1.5 rounded-lg text-xs text-slate-300 mr-1">
                <span class="text-slate-400 font-medium">Click circular date:</span>
                <span class="flex items-center gap-1.5 text-emerald-400 font-semibold"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> 1st: Completed</span>
                <span class="flex items-center gap-1.5 text-rose-400 font-semibold"><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> 2nd: Not Completed</span>
                <span class="flex items-center gap-1.5 text-amber-400 font-semibold"><span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span> 3rd: Skipped</span>
                <span class="flex items-center gap-1 text-slate-400"><i class="fa-regular fa-circle"></i> 4th: Clear</span>
            </div>

            <!-- Cloud Database Sync Badge -->
            <div id="cloudSyncBadge" class="px-3 py-1.5 rounded-lg bg-[#11192d] border border-slate-800 text-[11px] font-semibold text-slate-300 flex items-center gap-1.5">
                <span id="syncDot" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span id="syncText">Cloud Synced</span>
            </div>

            <!-- Account Sign In / Sign Up Button -->
            <button id="authHeaderBtn" onclick="openAuthModal()" class="px-3.5 py-1.5 rounded-lg bg-gradient-to-r from-sky-600 to-indigo-600 hover:from-sky-500 hover:to-indigo-500 text-white text-xs sm:text-sm font-semibold flex items-center gap-2 transition shadow-sm">
                <i class="fa-solid fa-user-lock text-xs"></i>
                <span id="authHeaderBtnText">Sign In / Sign Up</span>
            </button>

            <!-- Edit Profile Button -->
            <button onclick="openProfileModal()" class="px-3 py-1.5 rounded-lg bg-[#17223b] hover:bg-[#1f2e4f] border border-sky-500/30 text-sky-300 text-xs sm:text-sm font-medium flex items-center gap-1.5 transition shadow-sm">
                <i class="fa-solid fa-user-pen text-xs"></i>
                <span class="hidden sm:inline">Profile</span>
            </button>

            <!-- Print Tracker Button -->
            <button onclick="window.print()" class="px-3.5 py-1.5 rounded-lg bg-[#1a2336] hover:bg-[#25314a] border border-slate-700/80 text-slate-100 text-xs sm:text-sm font-medium flex items-center gap-2 transition shadow-sm">
                <i class="fa-solid fa-print text-xs text-slate-300"></i>
                <span class="hidden md:inline">Print Tracker</span>
            </button>

            <!-- Red Power / Account & Reset Button -->
            <button onclick="openResetModal()" title="Account Logout or Reset Options" class="w-9 h-8 rounded-lg bg-[#28141e] hover:bg-[#3d1a28] border border-rose-900/60 text-rose-400 hover:text-rose-300 flex items-center justify-center transition shadow-sm">
                <i class="fa-solid fa-power-off text-xs"></i>
            </button>
        </div>
    </header>

    <!-- MAIN CONTENT WORKSPACE: SIDEBAR (USER PROFILE) + TRACKER BOARD -->
    <div class="flex-1 flex flex-col lg:flex-row gap-4 p-3 sm:p-4 max-w-[1620px] w-full mx-auto">

        <!-- LEFT SIDEBAR: USER PROFILE DISPLAY (Main Name XXX, Surname/Title YYY, Photo, Email ID, Phone Number) -->
        <aside id="profileSidebar" class="w-full lg:w-[310px] xl:w-[330px] shrink-0 flex flex-col gap-4 transition-all duration-300">
            <div class="bg-[#0d1424] border border-sky-500/40 rounded-xl overflow-hidden shadow-[0_0_25px_rgba(2,132,199,0.12)] flex flex-col h-full">
                
                <!-- Top Profile Cover Banner -->
                <div class="h-20 cyan-banner relative flex items-end justify-between px-3 pb-2">
                    <span id="accountModeBadge" class="text-[10px] font-bold uppercase tracking-widest bg-black/45 text-amber-300 px-2.5 py-0.5 rounded-full backdrop-blur-sm flex items-center gap-1">
                        <i class="fa-solid fa-shield-halved"></i> Personal Dashboard
                    </span>
                    <button onclick="openAuthModal()" class="no-print text-[10px] font-bold uppercase tracking-wider bg-white/90 hover:bg-white text-slate-950 px-2.5 py-0.5 rounded-full shadow transition">
                        Switch Account
                    </button>
                </div>

                <!-- Avatar + Name Section -->
                <div class="px-5 pt-0 pb-5 flex flex-col items-center text-center relative flex-1">
                    <!-- Profile Photo Container -->
                    <div class="relative -mt-12 mb-3 group">
                        <div class="w-24 h-24 rounded-full p-1 bg-gradient-to-tr from-sky-500 via-cyan-300 to-blue-600 shadow-lg shadow-sky-500/20">
                            <img id="profilePhotoDisplay" 
                                 src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&q=80" 
                                 alt="User Profile Photo" 
                                 onerror="this.src='https://placehold.co/200x200/0284c7/ffffff?text=XXX'"
                                 class="w-full h-full object-cover rounded-full bg-[#0b101e] border-2 border-[#0d1424]">
                        </div>
                        <!-- Quick Upload Photo Trigger -->
                        <label for="quickPhotoUpload" title="Upload your photo" class="no-print cursor-pointer absolute bottom-0 right-0 w-8 h-8 rounded-full bg-sky-500 hover:bg-sky-400 text-slate-950 flex items-center justify-center shadow-md border-2 border-[#0d1424] transition transform group-hover:scale-110">
                            <i class="fa-solid fa-camera text-xs"></i>
                            <input id="quickPhotoUpload" type="file" accept="image/*" class="hidden" onchange="handlePhotoFileSelect(event)">
                        </label>
                    </div>

                    <!-- User Main Name (XXX) & Surname/Title (YYY) -->
                    <h2 id="profileNameDisplay" class="font-serif text-xl font-black text-white tracking-wide">
                        XXX
                    </h2>
                    <div class="mt-1 inline-flex items-center gap-1.5 px-3 py-0.5 rounded-md bg-sky-500/15 border border-sky-500/30">
                        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">Surname / Title:</span>
                        <span id="profileSurnameDisplay" class="text-xs font-extrabold text-sky-300 tracking-wide">YYY</span>
                    </div>

                    <!-- Status Badge -->
                    <div class="mt-2.5 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-950/60 border border-emerald-500/30 text-emerald-400 text-[11px] font-semibold">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>Total Completed: <strong id="profileStreakCount">0 Days</strong></span>
                    </div>

                    <!-- Divider -->
                    <div class="w-full h-[1px] bg-slate-800/90 my-4"></div>

                    <!-- Contact Information Cards (Main Name, Surname/Title, Email ID, Phone Number) -->
                    <div class="w-full space-y-2.5 text-left">
                        
                        <!-- Main Name & Surname/Title Box -->
                        <div class="grid grid-cols-2 gap-2">
                            <div class="bg-[#121b30] border border-slate-800/90 rounded-lg p-2.5 flex items-center gap-2.5 hover:border-sky-500/40 transition">
                                <div class="w-8 h-8 rounded-lg bg-sky-500/10 border border-sky-500/30 text-sky-400 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-user text-xs"></i>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-[9px] uppercase tracking-wider font-semibold text-slate-400">Main Name</p>
                                    <p id="cardMainNameText" class="text-xs font-bold text-slate-100 truncate">XXX</p>
                                </div>
                            </div>
                            <div class="bg-[#121b30] border border-slate-800/90 rounded-lg p-2.5 flex items-center gap-2.5 hover:border-sky-500/40 transition">
                                <div class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/30 text-indigo-400 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-award text-xs"></i>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-[9px] uppercase tracking-wider font-semibold text-slate-400">Surname/Title</p>
                                    <p id="cardSurnameText" class="text-xs font-bold text-slate-100 truncate">YYY</p>
                                </div>
                            </div>
                        </div>

                        <!-- Email ID Field Box -->
                        <div class="bg-[#121b30] border border-slate-800/90 rounded-lg p-2.5 flex items-center gap-3 hover:border-sky-500/40 transition group">
                            <div class="w-9 h-9 rounded-lg bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 flex items-center justify-center shrink-0">
                                <i class="fa-solid fa-envelope text-sm"></i>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-[10px] uppercase tracking-wider font-semibold text-slate-400">Email ID</p>
                                <p id="profileEmailDisplay" class="text-xs sm:text-sm font-semibold text-slate-100 truncate">xxx.yyy@example.com</p>
                            </div>
                            <button onclick="copyProfileField('email')" title="Copy Email" class="no-print opacity-60 group-hover:opacity-100 text-slate-400 hover:text-sky-400 p-1 transition">
                                <i class="fa-regular fa-copy text-xs"></i>
                            </button>
                        </div>

                        <!-- Phone Number Field Box -->
                        <div class="bg-[#121b30] border border-slate-800/90 rounded-lg p-2.5 flex items-center gap-3 hover:border-sky-500/40 transition group">
                            <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center justify-center shrink-0">
                                <i class="fa-solid fa-phone-volume text-sm"></i>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-[10px] uppercase tracking-wider font-semibold text-slate-400">Phone Number</p>
                                <p id="profilePhoneDisplay" class="text-xs sm:text-sm font-semibold text-slate-100 truncate">+91 98765 43210</p>
                            </div>
                            <button onclick="copyProfileField('phone')" title="Copy Phone Number" class="no-print opacity-60 group-hover:opacity-100 text-slate-400 hover:text-emerald-400 p-1 transition">
                                <i class="fa-regular fa-copy text-xs"></i>
                            </button>
                        </div>

                    </div>

                    <!-- Overall All-Tasks Progress Mini Widget -->
                    <div class="w-full mt-4 bg-[#10182b] border border-slate-800 rounded-xl p-3.5 text-left">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">All Tasks (<span id="sidebarMonthName">Oct 2026</span>)</span>
                            <span id="overallRateBadge" class="text-xs font-bold text-emerald-400">0%</span>
                        </div>
                        <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden mb-3">
                            <div id="overallProgressBar" class="h-full bg-gradient-to-r from-emerald-500 via-sky-500 to-cyan-400 transition-all duration-300" style="width: 0%"></div>
                        </div>
                        <div id="subjectMiniBreakdown" class="space-y-2 max-h-36 overflow-y-auto pr-1">
                            <!-- Dynamically populated task mini bars -->
                        </div>
                    </div>

                    <!-- Edit Profile & Photo CTA Button -->
                    <button onclick="openProfileModal()" class="no-print w-full mt-4 py-2.5 px-4 rounded-lg bg-gradient-to-r from-sky-600 to-cyan-600 hover:from-sky-500 hover:to-cyan-500 text-white font-semibold text-xs uppercase tracking-wider shadow-md flex items-center justify-center gap-2 transition">
                        <i class="fa-solid fa-pen-to-square"></i>
                        <span>Edit Name, Photo & Contact</span>
                    </button>
                </div>
            </div>
        </aside>

        <!-- RIGHT MAIN TRACKER CONTAINER -->
        <main class="flex-1 min-w-0 print-full">
            <div class="bg-[#0d1323] border border-[#0284c7] rounded-xl overflow-hidden shadow-[0_0_30px_rgba(2,132,199,0.15)]">

                <!-- 1. TOP CYAN BANNER: ( GENERAL - OCTOBER 2026 ) -->
                <div class="cyan-banner py-3.5 px-4 text-center border-b border-sky-400/30">
                    <h2 id="mainCyanBannerText" class="font-serif text-base sm:text-lg md:text-xl font-black text-[#04101e] tracking-[0.22em] uppercase">
                        ( GENERAL - OCTOBER 2026 )
                    </h2>
                </div>

                <!-- 2. TASK TABS & CONTROLS SECTION -->
                <div class="p-4 sm:p-5 space-y-5 bg-[#0e1526]">

                    <!-- Task Pills Row (Default: General + "+ Add Task") -->
                    <div class="flex flex-wrap items-center gap-2.5" id="taskTabsContainer">
                        <!-- Dynamically rendered task tabs + "+ Add Task" button -->
                    </div>

                    <!-- Month Navigation & Stats Row -->
                    <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4 pt-1">

                        <!-- Left: Month Selector ( <  October , 2026 [Calendar]  > ) -->
                        <div class="flex items-center gap-3">
                            <button onclick="changeMonth(-1)" title="Previous Month" class="w-10 h-10 rounded-full bg-[#131c31] hover:bg-[#1c2947] border border-slate-700/80 text-slate-300 hover:text-white flex items-center justify-center transition">
                                <i class="fa-solid fa-chevron-left text-xs"></i>
                            </button>

                            <div class="relative">
                                <button onclick="toggleMonthPicker()" class="min-w-[200px] sm:min-w-[225px] px-5 py-2.5 rounded-xl bg-[#11192c] hover:bg-[#16213a] border border-slate-700/80 text-white font-bold text-sm sm:text-base flex items-center justify-between gap-3 transition shadow-inner">
                                    <span id="currentMonthLabel" class="tracking-wide">October , 2026</span>
                                    <i class="fa-regular fa-calendar text-slate-400 text-sm"></i>
                                </button>

                                <!-- Quick Month/Year Dropdown Popover -->
                                <div id="monthPickerPopover" class="hidden absolute left-0 top-13 mt-2 w-72 bg-[#11192e] border border-sky-500/40 rounded-xl shadow-2xl p-4 z-50">
                                    <div class="flex items-center justify-between mb-3">
                                        <button onclick="changeYear(-1)" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-xs font-bold text-slate-200"><i class="fa-solid fa-angles-left"></i></button>
                                        <span id="pickerYearLabel" class="font-bold text-sky-400 text-sm">2026</span>
                                        <button onclick="changeYear(1)" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-xs font-bold text-slate-200"><i class="fa-solid fa-angles-right"></i></button>
                                    </div>
                                    <div id="pickerMonthsGrid" class="grid grid-cols-3 gap-1.5 text-xs">
                                        <!-- Populated by JS -->
                                    </div>
                                    <div class="mt-3 pt-2.5 border-t border-slate-800 flex justify-between">
                                        <button onclick="jumpToOct2026()" class="text-[11px] text-sky-400 hover:underline font-medium">Jump to Oct 25, 2026</button>
                                        <button onclick="toggleMonthPicker()" class="text-[11px] text-slate-400 hover:text-white">Close</button>
                                    </div>
                                </div>
                            </div>

                            <button onclick="changeMonth(1)" title="Next Month" class="w-10 h-10 rounded-full bg-[#131c31] hover:bg-[#1c2947] border border-slate-700/80 text-slate-300 hover:text-white flex items-center justify-center transition">
                                <i class="fa-solid fa-chevron-right text-xs"></i>
                            </button>
                        </div>

                        <!-- Right: COMPLETED | NOT COMPLETED | SKIPPED | SUCCESS RATE | GRAPH -->
                        <div class="flex flex-wrap items-center gap-2 sm:gap-3">

                            <!-- COMPLETED (Green) Box - Clickable to open Graph Drilldown -->
