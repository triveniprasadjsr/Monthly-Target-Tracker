        // 4. Render 6x7 Calendar Grid with Circular Dates (Green = Completed, Red = Not Completed, Yellow = Skipped)
        function renderCalendarGrid() {
            const grid = document.getElementById('calendarGrid');
            grid.innerHTML = '';

            const year = appState.currentYear;
            const month = appState.currentMonth;

            const firstDayIndex = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const totalCells = 42; // 6 rows x 7 columns

            for (let i = 0; i < totalCells; i++) {
                const dayNumber = i - firstDayIndex + 1;
                const cell = document.createElement('div');

                if (dayNumber < 1 || dayNumber > daysInMonth) {
                    cell.className = 'calendar-cell opacity-50';
                    grid.appendChild(cell);
                    continue;
                }

                const key = getRecordKey(appState.activeTask, year, month, dayNumber);
                const rawRecord = appState.records[key] || { status: null, note: '' };
                const status = normalizeStatus(rawRecord.status);
                const isSelectedDay = (dayNumber === appState.selectedDay);

                let cellStatusClass = '';
                let circleClass = 'date-circle-unmarked';
                let badgeIconHtml = '';

                if (status === 'completed') {
                    cellStatusClass = 'status-completed';
                    circleClass = 'date-circle-completed';
                    badgeIconHtml = `<span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-emerald-950 border border-emerald-300 text-emerald-300 flex items-center justify-center text-[9px] shadow"><i class="fa-solid fa-check"></i></span>`;
                } else if (status === 'not_completed') {
                    cellStatusClass = 'status-not_completed';
                    circleClass = 'date-circle-not_completed';
                    badgeIconHtml = `<span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-rose-950 border border-rose-300 text-rose-300 flex items-center justify-center text-[9px] shadow"><i class="fa-solid fa-xmark"></i></span>`;
                } else if (status === 'skipped') {
                    cellStatusClass = 'status-skipped';
                    circleClass = 'date-circle-skipped';
                    badgeIconHtml = `<span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-amber-950 border border-amber-300 text-amber-300 flex items-center justify-center text-[9px] shadow"><i class="fa-solid fa-minus"></i></span>`;
                }

                cell.className = `calendar-cell active-day p-2 flex flex-col items-center justify-between cursor-pointer group ${cellStatusClass} ${isSelectedDay ? 'selected-day' : ''}`;
                cell.onclick = () => handleDayCellClick(dayNumber);

                // Top Bar inside Cell: Status Label Pill + Note Edit Button
                const topRow = document.createElement('div');
                topRow.className = 'w-full flex items-center justify-between min-h-[16px]';

                const statusMiniLabel = document.createElement('span');
                statusMiniLabel.className = 'text-[9px] font-bold uppercase tracking-wider';
                if (status === 'completed') {
                    statusMiniLabel.className += ' text-emerald-400';
