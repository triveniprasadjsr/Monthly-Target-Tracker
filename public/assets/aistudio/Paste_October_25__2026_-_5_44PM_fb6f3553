    <!-- FIREBASE CLOUD AUTH & FIRESTORE DATABASE MODULE -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { 
            getAuth, 
            signInAnonymously, 
            signInWithCustomToken, 
            onAuthStateChanged, 
            createUserWithEmailAndPassword, 
            signInWithEmailAndPassword, 
            signOut 
        } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { 
            getFirestore, 
            doc, 
            setDoc, 
            getDoc, 
            onSnapshot 
        } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'monthly-target-tracker-app';
        let db = null;
        let auth = null;
        let currentUser = null;
        let unsubscribeSnapshot = null;

        // Deterministic email-keyed path so logging in with the same email & password on any session/device
        // always resolves to the user's exact personal dashboard in Firestore
        function getUserDashboardDocRef(uid, email) {
            if (email) {
                const safeEmailKey = email.trim().toLowerCase().replace(/[^a-z0-9]/g, '_');
                return doc(db, 'artifacts', appId, 'public', 'data', 'userDashboards', `acct_${safeEmailKey}`);
            }
            return doc(db, 'artifacts', appId, 'users', uid, 'trackerData', 'main');
        }

        async function initFirebaseCloud() {
            try {
                if (typeof __firebase_config === 'undefined' || !__firebase_config) {
                    window.updateSyncIndicator('ready', 'Ready');
                    return;
                }
                const firebaseConfig = JSON.parse(__firebase_config);
                const app = initializeApp(firebaseConfig);
                auth = getAuth(app);
                db = getFirestore(app);

                // Mandatory RULE 3: Authenticate first before any Firestore operations
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                onAuthStateChanged(auth, (user) => {
                    currentUser = user;
                    if (user) {
                        const activeEmail = window.getCurrentSignedInEmail();
                        window.updateAuthHeaderUI(user, activeEmail);
                        subscribeToUserDashboard(user.uid, activeEmail);
                    }
                });
            } catch (err) {
                console.error("Cloud initialization error:", err);
                window.updateSyncIndicator('error', 'Offline Mode');
            }
        }

        function subscribeToUserDashboard(uid, email) {
            if (!db || !currentUser) return;
            if (unsubscribeSnapshot) {
                unsubscribeSnapshot();
                unsubscribeSnapshot = null;
            }

            window.updateSyncIndicator('syncing', 'Syncing...');
            const docRef = getUserDashboardDocRef(uid, email);

            unsubscribeSnapshot = onSnapshot(docRef, (snapshot) => {
                if (snapshot.exists()) {
                    const cloudData = snapshot.data();
                    window.applyCloudDashboardData(cloudData);
                    window.updateSyncIndicator('synced', email ? `Synced (${email.split('@')[0]})` : 'Cloud Synced');
                } else {
                    // Initialize new personal dashboard document for this user
                    window.saveDashboardToCloud();
                }
            }, (err) => {
                console.error("Snapshot listener error:", err);
                window.updateSyncIndicator('error', 'Sync Error');
            });
        }

        // Expose Cloud Save function to main application script
        window.saveDashboardToCloud = async function () {
            if (!db || !currentUser) return;
            try {
                window.updateSyncIndicator('syncing', 'Saving...');
                const activeEmail = window.getCurrentSignedInEmail();
                const docRef = getUserDashboardDocRef(currentUser.uid, activeEmail);
                const payload = window.getSerializableStateForCloud();
                await setDoc(docRef, payload, { merge: true });
                window.updateSyncIndicator('synced', activeEmail ? `Synced (${activeEmail.split('@')[0]})` : 'Cloud Synced');
            } catch (err) {
                console.error("Save to cloud error:", err);
                window.updateSyncIndicator('error', 'Save Retry');
            }
        };

        // Handle Email & Password Sign Up / Sign In (Supports both native Firebase Email Auth & Credential-Protected Firestore Accounts)
        window.performEmailPasswordAuth = async function (mode, email, password, mainName, surname) {
            const cleanEmail = email.trim().toLowerCase();
            if (!db || !currentUser) {
                throw new Error("Cloud connection is initializing. Please try again in a moment.");
            }

            const accountDocRef = getUserDashboardDocRef(currentUser.uid, cleanEmail);
            const snap = await getDoc(accountDocRef);

            if (mode === 'signup') {
                if (snap.exists() && snap.data().accountPasswordHash) {
                    throw new Error("An account with this email already exists. Please switch to Sign In.");
                }
                // Try native Firebase Email Auth if enabled, otherwise use secure Firestore account
                try {
                    await createUserWithEmailAndPassword(auth, cleanEmail, password);
                } catch (authErr) {
                    // Fallback if Email/Password provider is not enabled in environment console
                }

                const freshDashboard = window.createFreshUserDashboard(cleanEmail, mainName || 'XXX', surname || 'YYY', password);
                await setDoc(accountDocRef, freshDashboard);
                window.setCurrentSignedInEmail(cleanEmail);
                window.applyCloudDashboardData(freshDashboard);
                subscribeToUserDashboard(currentUser.uid, cleanEmail);
                return { email: cleanEmail, isNew: true };
            } else {
                // Sign In Mode
                if (!snap.exists()) {
                    throw new Error("No account found with this email. Please click 'Sign Up (New User)' first.");
                }
                const data = snap.data();
                if (data.accountPasswordHash && data.accountPasswordHash !== btoa(password)) {
                    throw new Error("Incorrect password. Please check your password and try again.");
                }
                try {
                    await signInWithEmailAndPassword(auth, cleanEmail, password);
                } catch (authErr) {
                    // Continue with verified Firestore account
                }
                window.setCurrentSignedInEmail(cleanEmail);
                window.applyCloudDashboardData(data);
                subscribeToUserDashboard(currentUser.uid, cleanEmail);
                return { email: cleanEmail, isNew: false };
            }
        };

        window.performAccountSignOut = async function () {
            window.setCurrentSignedInEmail(null);
            window.resetToDefaultGuestDashboard();
            if (currentUser) {
                subscribeToUserDashboard(currentUser.uid, null);
            }
        };

        initFirebaseCloud();
    </script>

    <!-- MAIN APPLICATION SCRIPT -->
    <script>
        const MONTH_NAMES = [
            "January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"
        ];
        const SHORT_MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        const DAY_NAMES = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

        // Default Application State:
        // - Main Name = XXX, Surname/Title = YYY
        // - Default Task = General
        // - October 2026 with Day 25 highlighted
        const DEFAULT_STATE = {
            profile: {
                mainName: "XXX",
                surname: "YYY",
                email: "xxx.yyy@example.com",
                phone: "+91 98765 43210",
                photo: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&q=80"
            },
            tasks: ["General"],
            activeTask: "General",
            currentYear: 2026,
            currentMonth: 9, // 9 = October
            selectedDay: 25,
            // records key format: `${taskName}__${year}-${month}__${day}`
            // status values: 'completed' (Green) | 'not_completed' (Red) | 'skipped' (Yellow) | null
            records: {},
            accountPasswordHash: null
        };

        let appState = JSON.parse(JSON.stringify(DEFAULT_STATE));
        let editingDayNumber = null;
        let currentGraphFilter = 'all';
        let authModalMode = 'signin';
        let signedInUserEmail = null;
        let isApplyingCloudUpdate = false;

        // Normalize legacy status values ('met' -> 'completed', 'missed' -> 'not_completed')
        function normalizeStatus(status) {
            if (status === 'met' || status === 'completed') return 'completed';
            if (status === 'missed' || status === 'not_completed') return 'not_completed';
            if (status === 'skipped') return 'skipped';
            return null;
        }

        // Cloud Synchronization Helpers
        window.getCurrentSignedInEmail = function () {
            return signedInUserEmail;
        };

        window.setCurrentSignedInEmail = function (email) {
            signedInUserEmail = email;
            window.updateAuthHeaderUI(null, email);
        };

        window.createFreshUserDashboard = function (email, mainName, surname, rawPassword) {
            const fresh = JSON.parse(JSON.stringify(DEFAULT_STATE));
            fresh.profile.mainName = (mainName || "XXX").trim();
            fresh.profile.surname = (surname || "YYY").trim();
            fresh.profile.email = email;
            fresh.accountPasswordHash = btoa(rawPassword);
            return fresh;
        };

        window.resetToDefaultGuestDashboard = function () {
            appState = JSON.parse(JSON.stringify(DEFAULT_STATE));
            renderAll();
        };

        window.getSerializableStateForCloud = function () {
            return {
                profile: appState.profile,
                tasks: appState.tasks,
                activeTask: appState.activeTask,
                currentYear: appState.currentYear,
                currentMonth: appState.currentMonth,
                selectedDay: appState.selectedDay,
                recordsJson: JSON.stringify(appState.records || {}),
                accountPasswordHash: appState.accountPasswordHash || null,
                updatedAt: Date.now()
            };
        };

        window.applyCloudDashboardData = function (cloudData) {
            if (!cloudData) return;
            isApplyingCloudUpdate = true;
            try {
                if (cloudData.profile) {
                    appState.profile = {
                        mainName: cloudData.profile.mainName || cloudData.profile.name || "XXX",
                        surname: cloudData.profile.surname || cloudData.profile.role || "YYY",
                        email: cloudData.profile.email || "xxx.yyy@example.com",
                        phone: cloudData.profile.phone || "+91 98765 43210",
                        photo: cloudData.profile.photo || DEFAULT_STATE.profile.photo
                    };
                }
                if (Array.isArray(cloudData.tasks) && cloudData.tasks.length > 0) {
                    appState.tasks = cloudData.tasks;
                } else {
                    appState.tasks = ["General"];
                }
                if (cloudData.activeTask && appState.tasks.includes(cloudData.activeTask)) {
                    appState.activeTask = cloudData.activeTask;
                } else {
                    appState.activeTask = appState.tasks[0];
                }
                if (typeof cloudData.currentYear === 'number') appState.currentYear = cloudData.currentYear;
                if (typeof cloudData.currentMonth === 'number') appState.currentMonth = cloudData.currentMonth;
                if (typeof cloudData.selectedDay === 'number') appState.selectedDay = cloudData.selectedDay;
                if (cloudData.accountPasswordHash) appState.accountPasswordHash = cloudData.accountPasswordHash;

                if (cloudData.recordsJson) {
                    try {
                        appState.records = JSON.parse(cloudData.recordsJson) || {};
                    } catch (e) {
                        appState.records = {};
                    }
                } else if (cloudData.records && typeof cloudData.records === 'object') {
                    appState.records = cloudData.records;
                }
                renderAll();
            } finally {
                isApplyingCloudUpdate = false;
            }
        };

        function persistChanges() {
            if (isApplyingCloudUpdate) return;
            if (typeof window.saveDashboardToCloud === 'function') {
                window.saveDashboardToCloud();
            }
        }

        window.updateSyncIndicator = function (state, text) {
            const dot = document.getElementById('syncDot');
            const label = document.getElementById('syncText');
            if (!dot || !label) return;
            label.textContent = text;
            dot.className = 'w-2 h-2 rounded-full ';
            if (state === 'synced' || state === 'ready') {
                dot.className += 'bg-emerald-400';
            } else if (state === 'syncing') {
                dot.className += 'bg-sky-400 animate-ping';
            } else {
                dot.className += 'bg-amber-400';
            }
        };

        window.updateAuthHeaderUI = function (user, email) {
            const btnText = document.getElementById('authHeaderBtnText');
            const modeBadge = document.getElementById('accountModeBadge');
            const banner = document.getElementById('currentAccountBanner');
            const bannerEmail = document.getElementById('currentAccountEmail');

            if (email) {
                btnText.textContent = email.split('@')[0];
                modeBadge.innerHTML = `<i class="fa-solid fa-cloud-check text-emerald-400"></i> ${escapeHtml(email.split('@')[0])}`;
                if (banner && bannerEmail) {
                    banner.classList.remove('hidden');
                    bannerEmail.textContent = email;
                }
            } else {
                btnText.textContent = 'Sign In / Sign Up';
                modeBadge.innerHTML = `<i class="fa-solid fa-shield-halved"></i> Personal Dashboard`;
                if (banner) banner.classList.add('hidden');
            }
        };

        // Initialize on load
        window.onload = function () {
            renderAll();

            // Live preview of header name inside profile modal
            const mainNameInput = document.getElementById('inputProfileMainName');
            const surnameInput = document.getElementById('inputProfileSurname');
            const updateHeaderPreview = () => {
                const m = (mainNameInput?.value || 'XXX').trim();
                const s = (surnameInput?.value || 'YYY').trim();
                const previewEl = document.getElementById('previewHeaderName');
                if (previewEl) previewEl.textContent = `${m} ${s}`.trim();
            };
            if (mainNameInput) mainNameInput.addEventListener('input', updateHeaderPreview);
            if (surnameInput) surnameInput.addEventListener('input', updateHeaderPreview);
        };

        // Main Render Orchestrator
        function renderAll() {
            renderProfileUI();
            renderBannerAndHeader();
            renderTaskTabs();
            renderCalendarGrid();
            renderStats();
            renderSidebarOverview();
        }

        // 1. Render Profile Sidebar & Header Title (Main Name = XXX, Surname/Title = YYY)
        function renderProfileUI() {
            const p = appState.profile;
            const mainName = (p.mainName || "XXX").trim();
            const surname = (p.surname || "YYY").trim();
            const combinedName = `${mainName} ${surname}`.trim();

            document.getElementById('headerTitle').textContent = `${combinedName}’s Target Tracker`;
            document.getElementById('profilePhotoDisplay').src = p.photo;
            document.getElementById('profileNameDisplay').textContent = mainName;
            document.getElementById('profileSurnameDisplay').textContent = surname;
            document.getElementById('cardMainNameText').textContent = mainName;
            document.getElementById('cardSurnameText').textContent = surname;
            document.getElementById('profileEmailDisplay').textContent = p.email;
            document.getElementById('profilePhoneDisplay').textContent = p.phone;
        }

        // 2. Render Top Cyan Banner & Month Label
        function renderBannerAndHeader() {
            const monthName = MONTH_NAMES[appState.currentMonth];
            const bannerText = `( ${appState.activeTask.toUpperCase()} - ${monthName.toUpperCase()} ${appState.currentYear} )`;
            document.getElementById('mainCyanBannerText').textContent = bannerText;
            document.getElementById('currentMonthLabel').textContent = `${monthName} , ${appState.currentYear}`;
            document.getElementById('sidebarMonthName').textContent = `${SHORT_MONTHS[appState.currentMonth]} ${appState.currentYear}`;
        }

        // 3. Render Task Tabs (Default = General, plus custom tasks & "+ Add Task")
        function renderTaskTabs() {
            const container = document.getElementById('taskTabsContainer');
            container.innerHTML = '';

            appState.tasks.forEach((taskName) => {
                const isActive = taskName === appState.activeTask;
                const btnWrapper = document.createElement('div');
                btnWrapper.className = 'relative group flex items-center';

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.onclick = () => selectTask(taskName);

                if (isActive) {
                    btn.className = 'px-6 py-2.5 rounded-xl bg-[#0ea5e9] text-slate-950 font-bold text-xs sm:text-sm tracking-wide shadow-md shadow-sky-500/20 transition flex items-center gap-2';
