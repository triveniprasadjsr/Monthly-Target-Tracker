        // Helper: Compute stats for a given task/year/month
        function getTaskMonthStats(taskName, year, month) {
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            let completed = 0;
            let notCompleted = 0;
            let skipped = 0;

            for (let d = 1; d <= daysInMonth; d++) {
                const key = getRecordKey(taskName, year, month, d);
                const status = normalizeStatus(appState.records[key]?.status);
                if (status === 'completed') completed++;
                else if (status === 'not_completed') notCompleted++;
                else if (status === 'skipped') skipped++;
            }

            // Success rate based on Completed vs (Completed + Not Completed)
            const totalEvaluated = completed + notCompleted;
            const rate = totalEvaluated > 0 ? Math.round((completed / totalEvaluated) * 100) : 0;
            return { completed, notCompleted, skipped, rate, daysInMonth };
        }

        function getRecordKey(task, year, month, day) {
            return `${task}__${year}-${month}__${day}`;
        }

        // Interaction: Click Circular Date to Cycle Status:
        // Unmarked -> Completed (Green) -> Not Completed (Red) -> Skipped (Yellow) -> Unmarked
        function handleDayCellClick(dayNumber) {
            appState.selectedDay = dayNumber;
            const key = getRecordKey(appState.activeTask, appState.currentYear, appState.currentMonth, dayNumber);
            const existing = appState.records[key] || { status: null, note: '' };
            const currentStatus = normalizeStatus(existing.status);

            if (!currentStatus) {
                existing.status = 'completed';
            } else if (currentStatus === 'completed') {
                existing.status = 'not_completed';
            } else if (currentStatus === 'not_completed') {
                existing.status = 'skipped';
            } else {
                existing.status = null;
            }

            appState.records[key] = existing;
            renderAll();
            persistChanges();
        }

