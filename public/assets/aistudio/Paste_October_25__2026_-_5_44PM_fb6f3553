                if (pill) {
                    if (type === filterType) {
                        pill.className = 'px-2.5 py-1 rounded-md bg-sky-500 text-slate-950 font-bold';
                    } else {
                        pill.className = 'px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 hover:bg-slate-700 font-semibold';
                    }
                }
            });

            const listContainer = document.getElementById('graphDrilldownList');
            listContainer.innerHTML = '';

            const matchingDays = [];
            for (let d = 1; d <= daysInMonth; d++) {
                const key = getRecordKey(appState.activeTask, year, month, d);
                const rec = appState.records[key];
                const status = normalizeStatus(rec?.status);
                const note = rec?.note || '';

                if (filterType === 'all') {
                    if (status || note) matchingDays.push({ day: d, status, note });
                } else if (status === filterType) {
                    matchingDays.push({ day: d, status, note });
                }
            }

            const titleMap = {
                all: `All Recorded Dates in ${monthName} ${year} (${matchingDays.length})`,
                completed: `Completed (Green) Dates in ${monthName} ${year} (${matchingDays.length})`,
                not_completed: `Not Completed (Red) Dates in ${monthName} ${year} (${matchingDays.length})`,
                skipped: `Skipped (Yellow) Dates in ${monthName} ${year} (${matchingDays.length})`
            };
            document.getElementById('drilldownHeaderTitle').innerHTML = `<i class="fa-solid fa-list-check text-sky-400"></i><span>${titleMap[filterType]}</span>`;

            if (matchingDays.length === 0) {
                listContainer.innerHTML = `
                    <div class="text-center py-6 text-xs text-slate-400 bg-[#0b1120] rounded-xl border border-slate-800/70">
                        No dates match this status yet in ${monthName} ${year}. Click any circular date on the calendar to mark it!
                    </div>
                `;
                return;
            }

            matchingDays.forEach(item => {
                const dateObj = new Date(year, month, item.day);
                const dayOfWeekName = DAY_NAMES[dateObj.getDay()];

                let badgeClass = 'bg-slate-800 text-slate-300 border-slate-600';
                let statusText = 'Note Only';
                let circleColor = 'bg-slate-700 text-white';

                if (item.status === 'completed') {
                    badgeClass = 'bg-emerald-950/80 text-emerald-300 border-emerald-500/40';
                    statusText = 'Completed ✓';
                    circleColor = 'bg-emerald-500 text-white';
                } else if (item.status === 'not_completed') {
                    badgeClass = 'bg-rose-950/80 text-rose-300 border-rose-500/40';
                    statusText = 'Not Completed ✕';
                    circleColor = 'bg-rose-500 text-white';
                } else if (item.status === 'skipped') {
                    badgeClass = 'bg-amber-950/80 text-amber-300 border-amber-500/40';
                    statusText = 'Skipped −';
                    circleColor = 'bg-amber-400 text-slate-950';
                }

                const row = document.createElement('div');
                row.className = 'flex items-center justify-between gap-3 p-2.5 rounded-xl bg-[#0c1324] border border-slate-800 hover:border-sky-500/40 transition';
                row.innerHTML = `
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-9 h-9 rounded-full ${circleColor} font-black text-xs flex items-center justify-center shrink-0 shadow">
                            ${item.day}
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-bold text-white">${monthName} ${item.day}, ${year} (${dayOfWeekName})</span>
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border ${badgeClass}">${statusText}</span>
                            </div>
                            <p class="text-[11px] text-slate-400 truncate mt-0.5">
                                ${item.note ? `<i class="fa-regular fa-comment-dots text-sky-400 mr-1"></i>${escapeHtml(item.note)}` : 'No additional note added for this date.'}
                            </p>
                        </div>
                    </div>
                    <button type="button" onclick="closeGraphModal(); openDayNoteModal(${item.day});" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-sky-500 hover:text-slate-950 text-slate-300 text-[11px] font-semibold shrink-0 transition">
                        Edit Details
                    </button>
                `;
                listContainer.appendChild(row);
            });
        }

        function closeGraphModal() {
            document.getElementById('graphModal').classList.add('hidden');
        }

        // Bulk Actions & Reset
        function markAllMonth(status) {
            const daysInMonth = new Date(appState.currentYear, appState.currentMonth + 1, 0).getDate();
            for (let d = 1; d <= daysInMonth; d++) {
                const key = getRecordKey(appState.activeTask, appState.currentYear, appState.currentMonth, d);
                const existing = appState.records[key] || { status: null, note: '' };
                existing.status = status;
                appState.records[key] = existing;
            }
            renderAll();
            persistChanges();
            showToast(`Marked all days in ${MONTH_NAMES[appState.currentMonth]} as Completed!`);
        }

        function clearCurrentTaskMonth() {
            const daysInMonth = new Date(appState.currentYear, appState.currentMonth + 1, 0).getDate();
            for (let d = 1; d <= daysInMonth; d++) {
                const key = getRecordKey(appState.activeTask, appState.currentYear, appState.currentMonth, d);
                delete appState.records[key];
            }
            renderAll();
            persistChanges();
            showToast(`Cleared ${appState.activeTask} entries for ${MONTH_NAMES[appState.currentMonth]}.`);
        }

        function openResetModal() {
            document.getElementById('resetTaskLabel').textContent = appState.activeTask;
            document.getElementById('resetModal').classList.remove('hidden');
        }

        function closeResetModal() {
            document.getElementById('resetModal').classList.add('hidden');
        }

        function resetEntireApp() {
            appState = JSON.parse(JSON.stringify(DEFAULT_STATE));
            closeResetModal();
            renderAll();
            persistChanges();
            showToast("Dashboard reset to default state.");
        }

        // Toast Helper
        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById('toastNotification');
            document.getElementById('toastMessage').textContent = msg;
            toast.classList.remove('hidden');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('hidden');
            }, 2600);
        }

        function escapeHtml(str) {
            return String(str).replace(/[&<>"']/g, function(m) {
                return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[m];
            });
        }
    </script>
</body>
</html>