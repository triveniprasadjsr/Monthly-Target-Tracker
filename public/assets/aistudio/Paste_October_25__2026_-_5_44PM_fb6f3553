                } else if (status === 'not_completed') {
                    statusMiniLabel.className += ' text-rose-400';
                    statusMiniLabel.textContent = 'Missed';
                } else if (status === 'skipped') {
                    statusMiniLabel.className += ' text-amber-400';
                    statusMiniLabel.textContent = 'Skipped';
                } else {
                    statusMiniLabel.innerHTML = '&nbsp;';
                }

                const editNoteBtn = document.createElement('button');
                editNoteBtn.type = 'button';
                editNoteBtn.title = 'Set status or add daily details';
                editNoteBtn.className = `no-print ${rawRecord.note ? 'opacity-100 text-sky-400' : 'opacity-0 group-hover:opacity-100 text-slate-400'} hover:text-sky-300 text-[11px] px-1 transition`;
                editNoteBtn.innerHTML = '<i class="fa-regular fa-pen-to-square"></i>';
                editNoteBtn.onclick = (e) => {
                    e.stopPropagation();
                    openDayNoteModal(dayNumber);
